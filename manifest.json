{
  "name": "My File Opener",
  "short_name": "Opener",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f1418",
  "theme_color": "#0f1418",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./receive",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "file", "accept": ["*/*"] }] }
  }
}
